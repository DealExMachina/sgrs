{
  "name": "@sgrs/api",
  "version": "0.1.0",
  "description": "SGRS REST API server — Hono + Drizzle + DuckDB",
  "license": "BUSL-1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file=../../.env.local src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'lint skipped'"
  },
  "dependencies": {
    "@hono/node-server": "2.0.1",
    "@hono/zod-validator": "0.7.6",
    "@sgrs/api-schema": "workspace:*",
    "@sgrs/client-ts": "workspace:*",
    "@sgrs/db": "workspace:*",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.16",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@vitest/coverage-v8": "3.2.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
