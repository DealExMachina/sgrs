{
  "name": "@sgrs/client-nats",
  "version": "0.1.0",
  "description": "Compatibility wrapper for SGRS NATS events; canonical implementation is @sgrs/client-ts/events",
  "keywords": ["sgrs", "nats", "governance", "finality", "events", "real-time"],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schema": {
      "import": "./dist/schema.js",
      "types": "./dist/schema.d.ts"
    },
    "./subjects": {
      "import": "./dist/subjects.js",
      "types": "./dist/subjects.d.ts"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "pnpm --dir ../.. --filter @sgrs/api-schema build && pnpm --dir ../.. --filter @sgrs/client-ts build && tsc",
    "dev": "tsc --watch",
    "typecheck": "pnpm --dir ../.. --filter @sgrs/api-schema build && pnpm --dir ../.. --filter @sgrs/client-ts build && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@sgrs/api-schema": "workspace:*",
    "@sgrs/client-ts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  }
}
