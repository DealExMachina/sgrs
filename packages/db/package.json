{
  "name": "@sgrs/db",
  "version": "0.1.0",
  "description": "SGRS persistence layer — Drizzle ORM (PGlite / PostgreSQL) + DuckDB analytics",
  "license": "BUSL-1.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "drizzle"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'lint skipped'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.2-r.1",
    "@electric-sql/pglite": "0.4.5",
    "@sgrs/api-schema": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
