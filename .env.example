# ─── SGRS environment variables ─────────────────────────────────────────────
# Copy to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
#
# Local port contract (keep in sync with ROUTING_ARCHITECTURE.md):
#   Studio :3001  |  SGRS API :3003  |  Kernel feed :3002  |  Kernel demo UI :3005  |  Kernel resolution MCP :3006  |  OpenFGA :3000

# ── Database ─────────────────────────────────────────────────────────────────
# Leave unset (or use the PGlite file path below) for local dev — no Postgres needed.
# DATABASE_URL=:memory:
# DATABASE_URL=./data/sgrs.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/sgrs
DATABASE_URL=./data/sgrs.db

# Connection pool size (postgres-js only, ignored for PGlite)
# DATABASE_POOL_SIZE=10

# ── DuckDB analytics ─────────────────────────────────────────────────────────
# Leave unset to use in-memory DuckDB (resets on restart).
# DUCKDB_PATH=./data/sgrs-analytics.duckdb
DUCKDB_PATH=./data/sgrs-analytics.duckdb

# ── Encryption (REQUIRED for production) ────────────────────────────────────
# 32-byte AES-256-GCM key, base64-encoded.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ENCRYPTION_KEY=<base64-encoded-32-bytes>
ENCRYPTION_KEY=REPLACE_ME_generate_with_node_crypto

# ── API server ────────────────────────────────────────────────────────────────
# Must match NEXT_PUBLIC_BACKEND_API_URL so Studio's /api/* proxy reaches this process.
PORT=3003
NODE_ENV=development

# Tiered API auth keys (preferred):
# TENANT_API_KEY=tenant-tier-key
# ADMIN_API_KEY=admin-tier-key
# GODLIKE_API_KEY=godlike-tier-key
# GODLIKE_IP_ALLOWLIST=10.0.0.1,10.0.0.2
#
# Legacy fallback (tenant tier only):
# API_KEY=legacy-tenant-key

# Comma-separated CORS origins (production only).
# CORS_ORIGINS=https://studio.example.com,https://app.example.com

# ── NATS real-time events (optional) ─────────────────────────────────────────
# Leave unset to disable real-time governance event publishing.
# tls:// or wss:// required in production; nats:// or ws:// for local dev only.
# NATS_URL=nats://localhost:4222
# NATS_TOKEN=your-nats-token

# ── Kernel routing (admin/internals proxy) ───────────────────────────────────
# Preferred: point feed base URL (sgrs proxies /v1/* to this service).
# FEED_SERVER_URL=http://localhost:3002
#
# Required for admin/control-plane routes:
# KERNEL_CONTROL_PLANE_ADMIN_TOKEN=replace-me
# SWARM_API_TOKEN=replace-me

# ── Clerk (hosted demo / production Studio auth) ─────────────────────────────
# Create a Clerk application with Google, Apple, and email sign-in enabled.
# CLERK_SECRET_KEY=sk_live_…
# CLERK_WEBHOOK_SECRET=whsec_…
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_…
# NEXT_PUBLIC_DEFAULT_PROJECT_ID=deal-ex-machina-default

# Pepper for hashing product API keys (sk_live_… / sk_test_…).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# API_KEY_PEPPER=<base64-or-long-random-string>

# ── Studio (Next.js) ─────────────────────────────────────────────────────────
# These are injected at build time — must be prefixed with NEXT_PUBLIC_.
# Browser client talks to Studio origin (same-origin /api/* proxy), not the API port directly.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Where Studio server-side routes forward /api/* (must match PORT above).
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:3003
NEXT_PUBLIC_TENANT_ID=deal-ex-machina

# Studio's SSE route handler (GET /api/stream/:tenant) also reads NATS_URL and
# NATS_TOKEN from above. No extra variables needed — set them once for both the
# API server and the Studio if running in separate processes.

# If API_KEY is set above, also set it here for the Studio's server-side fetch:
# NEXT_PUBLIC_API_KEY=your-secret-api-key
