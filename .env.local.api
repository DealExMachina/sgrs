# API server configuration (runs separately from Studio)
# Canonical product API port is 3003 (kernel feed is 3002 — do not use for apps/api).
PORT=3003
NODE_ENV=development

# NATS for real-time events
NATS_URL=nats://localhost:4222

# S3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=swarm
