{
  "name": "@sgrs/client-nats",
  "version": "0.0.0",
  "description": "NATS real-time event client for SGRS governance platform",
  "keywords": ["sgrs", "nats", "governance", "finality", "events", "real-time"],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schema": {
      "import": "./dist/schema.js",
      "types": "./dist/schema.d.ts"
    },
    "./subjects": {
      "import": "./dist/subjects.js",
      "types": "./dist/subjects.d.ts"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@sgrs/api-schema": "workspace:*",
    "nats": "2.28.2"
  },
  "devDependencies": {
    "typescript": "5.7.2",
    "vitest": "1.0.4",
    "@types/node": "22.10.5"
  }
}
