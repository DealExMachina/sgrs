{
  "name": "@sgrs/api-schema",
  "version": "0.1.0",
  "description": "OpenAPI 3.1 + Zod schemas for the SGRS REST API (source of truth).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "openapi.json"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'lint skipped'"
  },
  "dependencies": {
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
