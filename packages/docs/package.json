{
  "name": "@sgrs/docs",
  "version": "0.2.0",
  "private": true,
  "description": "Aggregated API (OpenAPI) + TypeScript SDK reference — generated from @sgrs/api-schema and @sgrs/client-ts",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "docs": "node scripts/build.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@sgrs/client-ts": "workspace:*"
  },
  "devDependencies": {
    "@redocly/cli": "^2.39.0",
    "typedoc": "^0.28.20",
    "typescript": "5.9.3"
  },
  "turbo": {
    "tasks": {
      "docs": {
        "inputs": [
          "scripts/**",
          "typedoc.json",
          "../api-schema/openapi.json",
          "../client-ts/src/**",
          "../client-ts/README.md"
        ]
      }
    }
  }
}
