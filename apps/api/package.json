{
  "name": "@sgrs/api",
  "version": "0.0.0",
  "description": "SGRS REST API server — Hono + Drizzle + DuckDB",
  "license": "BUSL-1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'lint skipped'"
  },
  "dependencies": {
    "@hono/node-server": "1.13.7",
    "@hono/zod-validator": "0.4.3",
    "@sgrs/api-schema": "workspace:*",
    "@sgrs/client-ts": "workspace:*",
    "@sgrs/db": "workspace:*",
    "hono": "4.7.5"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@vitest/coverage-v8": "1.0.4",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "1.0.4"
  }
}
