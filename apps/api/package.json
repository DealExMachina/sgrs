{
  "name": "@sgrs/api",
  "version": "0.2.0",
  "description": "SGRS REST API server — Hono + Drizzle + DuckDB",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file=../../.env.local src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@hono/node-server": "2.0.11",
    "@hono/zod-validator": "0.8.0",
    "@sgrs/api-schema": "workspace:*",
    "@sgrs/client-ts": "workspace:*",
    "@sgrs/db": "workspace:*",
    "@clerk/backend": "^2.6.0",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.31",
    "svix": "^1.62.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@vitest/coverage-v8": "4.1.10",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.10"
  }
}
